{
  "siteUrl": "https://www.healthwise360.co.uk",

  "prototypeUrls": [
    "/what-is-mounjaro",
    "/mounjaro-price-comparison",
    "/blog/mounjaro-click-calculator-uk",
    "/tools/mounjaro-click-calculator"
  ],

  "pageTypeRules": [
    { "pattern": "/blog/page/*", "type": "Archive" },
    { "pattern": "/blog/topic/*", "type": "Archive" },
